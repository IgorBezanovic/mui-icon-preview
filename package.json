{
  "name": "mui-icon-preview",
  "displayName": "MUI Icon Preview",
  "description": "Preview Material UI icons in VS Code hovers and completions.",
  "publisher": "IgorBezanovic",
  "author": {
    "name": "Igor Bezanovic",
    "email": "igorbezanovic@gmail.com"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/IgorBezanovic/mui-icon-preview.git"
  },
  "homepage": "https://github.com/IgorBezanovic/mui-icon-preview#readme",
  "bugs": {
    "url": "https://github.com/IgorBezanovic/mui-icon-preview/issues",
    "email": "igorbezanovic@gmail.com"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "mui",
    "material ui",
    "material icons",
    "icons",
    "svg",
    "hover",
    "preview",
    "react"
  ],
  "galleryBanner": {
    "color": "#087EA4",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "badges": [
    {
      "url": "https://img.shields.io/github/license/IgorBezanovic/mui-icon-preview",
      "href": "https://github.com/IgorBezanovic/mui-icon-preview/blob/master/LICENSE",
      "description": "MIT License"
    }
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "muiIconPreview.searchIcons",
        "title": "Search",
        "category": "MUI Icons"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vscode-test",
    "vsce:package": "vsce package",
    "vsce:publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
